      nodes.size = 109 - 2 ∧ RepresentativeChecks 109 nodes rows :=
  ⟨nodes, rows, by decide, dataChecks⟩

theorem original_roots {k : ℕ} (hk : 3 ≤ k) (kn : k ≤ 109) :
    SimpleDescentRootPattern 109 k :=
  simpleDescentRoots_of_representativeChecks (by decide) (by decide) dataChecks hk kn

