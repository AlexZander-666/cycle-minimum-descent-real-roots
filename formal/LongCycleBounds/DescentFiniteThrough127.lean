theorem simple_roots_through127 {n k : ℕ} (lo : 3 ≤ n) (hi : n ≤ 127)
    (five : n ≠ 5) (hk : 3 ≤ k) (kn : k ≤ n) : SimpleDescentRootPattern n k := by
  obtain ⟨nodes, rows, size, checked⟩ := finite_certificate_through127 lo hi five
  exact simpleDescentRoots_of_representativeChecks lo size checked hk kn

theorem splits_through127 {n k : ℕ} (lo : 3 ≤ n) (hi : n ≤ 127)
    (hk : 3 ≤ k) (kn : k ≤ n) :
    ((DescentTwoLetters.row n k).map (Int.castRingHom ℝ)).Splits := by
  by_cases five : n = 5
  · subst n
    exact row_five_splits hk kn
  · exact (simple_roots_through127 lo hi five hk kn).1

