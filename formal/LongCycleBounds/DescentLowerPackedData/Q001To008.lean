/-! The extra cutoff factors for alphabets 1 through 8. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q001

private def one : ℕ := 0xffffffffffffffffffffffffffffffff
private def two : ℕ := 0x1

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 1) 127 2
    (primitiveCount 2 1) (Packed.C127Q001.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 1) 127 1
    (primitiveCount 1 1) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q001.code

theorem checked : PackedCutoffChecks 127 1 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q001.checked twoStep oneStep

#print axioms checked
end Q001

