/-! The extra cutoff factors for alphabets 17 through 24. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q017

private def one : ℕ := 
private def two : ℕ := 

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 17) 127 2
    (primitiveCount 2 17) (Packed.C127Q017.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 17) 127 1
    (primitiveCount 1 17) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q017.code

theorem checked : PackedCutoffChecks 127 17 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q017.checked twoStep oneStep

#print axioms checked
end Q017

