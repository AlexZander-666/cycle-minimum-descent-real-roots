/-! The extra cutoff factors for alphabets 65 through 72. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q065

private def one : ℕ := 
private def two : ℕ := 

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 65) 127 2
    (primitiveCount 2 65) (Packed.C127Q065.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 65) 127 1
    (primitiveCount 1 65) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q065.code

theorem checked : PackedCutoffChecks 127 65 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q065.checked twoStep oneStep

#print axioms checked
end Q065

