/-! The extra cutoff factors for alphabets 89 through 96. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q089

private def one : ℕ := 
private def two : ℕ := 

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 89) 127 2
    (primitiveCount 2 89) (Packed.C127Q089.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 89) 127 1
    (primitiveCount 1 89) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q089.code

theorem checked : PackedCutoffChecks 127 89 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q089.checked twoStep oneStep

#print axioms checked
end Q089

