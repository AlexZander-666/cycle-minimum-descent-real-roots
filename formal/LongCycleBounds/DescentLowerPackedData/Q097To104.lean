/-! The extra cutoff factors for alphabets 97 through 104. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q097

private def one : ℕ := 
private def two : ℕ := 

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 97) 127 2
    (primitiveCount 2 97) (Packed.C127Q097.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 97) 127 1
    (primitiveCount 1 97) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q097.code

theorem checked : PackedCutoffChecks 127 97 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q097.checked twoStep oneStep

#print axioms checked
end Q097

