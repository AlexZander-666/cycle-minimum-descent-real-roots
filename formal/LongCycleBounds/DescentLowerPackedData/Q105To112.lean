/-! The extra cutoff factors for alphabets 105 through 112. -/

namespace LongCycleBounds.DescentNecklace.LowerPacked
set_option maxRecDepth 65536
set_option maxHeartbeats 25000000
set_option Elab.async false

namespace Q105

private def one : ℕ := 
private def two : ℕ := 

private theorem twoStep : two = codedCutoffStep (cutoffRadix 127 105) 127 2
    (primitiveCount 2 105) (Packed.C127Q105.code 3) := by
  decide +kernel

private theorem oneStep : one = codedCutoffStep (cutoffRadix 127 105) 127 1
    (primitiveCount 1 105) two := by
  decide +kernel

def code : ℕ → ℕ := cachedLowerCode one two Packed.C127Q105.code

theorem checked : PackedCutoffChecks 127 105 1 code :=
  packedChecks_of_cachedLower (by decide) Packed.C127Q105.checked twoStep oneStep

#print axioms checked
end Q105

