      nodes.size = 67 - 2 ∧ RepresentativeChecks 67 nodes rows :=
  ⟨nodes, rows, by decide, dataChecks⟩

theorem original_roots {k : ℕ} (hk : 3 ≤ k) (kn : k ≤ 67) :
    SimpleDescentRootPattern 67 k :=
  simpleDescentRoots_of_representativeChecks (by decide) (by decide) dataChecks hk kn

