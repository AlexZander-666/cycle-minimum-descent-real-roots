      nodes.size = 68 - 2 ∧ RepresentativeChecks 68 nodes rows :=
  ⟨nodes, rows, by decide, dataChecks⟩

theorem original_roots {k : ℕ} (hk : 3 ≤ k) (kn : k ≤ 68) :
    SimpleDescentRootPattern 68 k :=
  simpleDescentRoots_of_representativeChecks (by decide) (by decide) dataChecks hk kn

